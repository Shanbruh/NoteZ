{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "notez-backend/**",
      "notez-backend-langchain/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.env",
      "**/.env.*",
      "main.py",
      "requirements.txt",
      "DEPLOYMENT.md",
      "env.example"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
