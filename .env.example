# Copy to .env and fill in real values. Never commit .env.

# One or more Gemini API keys, comma-separated.
GEMINI_API_KEYS=your_gemini_api_key_here

# Firebase project's Web API key; used to verify Firebase ID tokens.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# API server port (default: 8787).
PORT=8787

# Restrict this to your deployed frontend origin in production.
# Example: https://ai-notez.web.app
ALLOWED_ORIGIN=*

# Daily request caps.
AUTH_DAILY_LIMIT=300
ANON_DAILY_LIMIT=20
