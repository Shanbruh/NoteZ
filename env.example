# Copy this file to .env and fill in your real values.
# .env should NEVER be committed to git — it's already in .gitignore.

# One or more Gemini API keys, comma-separated (get one free at aistudio.google.com/apikey).
GEMINI_API_KEYS=your_real_gemini_key_here

# Your Firebase project's Web API key — the same one the NoteZ frontend
# already uses for sign-in (search FB_API_KEY in index.html). This one is
# fine to copy; it's not a secret the way the Gemini key is.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Port the server listens on locally.
PORT=8787

# Once you know your frontend's real URL, set this so only that origin can
# call your backend. Leave as * while testing locally.
# Your Firebase Hosting project is "ai-notez", so once deployed this is
# likely: https://ai-notez.web.app  (Firebase also serves the same site at
# https://ai-notez.firebaseapp.com — if you use that URL too, you'll need a
# small code change to allow a list of origins instead of one, since Access-
# Control-Allow-Origin only accepts a single value per response).
ALLOWED_ORIGIN=*

# Daily request caps — logged-in NoteZ users vs anonymous/Test Mode traffic.
AUTH_DAILY_LIMIT=300
ANON_DAILY_LIMIT=20
